{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Goyak",
  "version": "1.0.3",
  "identifier": "app.goyak.desktop",
  "build": {
    "beforeDevCommand": "bun dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Goyak — AI Real-Time Dubbing",
        "width": 800,
        "height": 600,
        "decorations": false,
        "resizable": false,
        "fullscreen": false,
        "center": true,
        "devtools": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDJGQTVGNTZDRkU1QjAwMzkKUldRNUFGditiUFdsTHp2S1NQbERhVUgzVlhwZXFMa2xPajBubGV5c3RVaklJd1FwYzY1YnBJT2UK",
      "endpoints": [
        "https://github.com/goyak-app/goyak-desktop/releases/latest/download/latest.json"
      ]
    }
  }
}
